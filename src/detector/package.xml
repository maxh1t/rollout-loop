<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>detector</name>
  <version>0.1.2</version>
  <description>Vision Stand: camera + on-device object detection pipeline for a networked Raspberry Pi vision stand.</description>
  <maintainer email="m4xh17@gmail.com">max</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>image_transport</exec_depend>

  <!-- onnxruntime has no apt/rosdep key for its Python bindings on this
       platform; install via pip with the "break system packages" flag
       (see README). -->


  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
