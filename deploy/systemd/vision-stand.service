[Unit]
Description=Vision Stand detector pipeline (containerized)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/vision-stand/version.env
ExecStartPre=-/usr/bin/docker rm -f vision-stand
ExecStart=/bin/bash -c 'exec docker run --rm --name vision-stand --network host --ipc host -v /dev:/dev --device-cgroup-rule="c 81:* rmw" -e ROS_DOMAIN_ID=42 ghcr.io/maxh1t/rollout-loop:$IMAGE_TAG ros2 launch detector pipeline.launch.py source:=$CAMERA_SOURCE compressed:=true'
ExecStop=/usr/bin/docker stop vision-stand
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
